# Kernel Source and config naming.
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_motorola_sm8250
KERNEL_SOURCE_BRANCH=lineage-23.2
KERNEL_CONFIG=vendor/lito-perf_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=true
EXTRA_CMDS:LD="ld.lld -z muldefs" LOCALVERSION=23-kiev

# KernelSU flags
ENABLE_KERNELSU=true
KERNELSU_TAG=legacy
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
Kernel_Version=4.19
Kernel_Extra_Version=4.19.325

# Boot image source
SOURCE_BOOT_IMAGE=https://mirrorbits.lineageos.org/full/kiev/20261004/boot.img
